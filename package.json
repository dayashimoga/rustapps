{
  "name": "offline-apps-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade, offline-first standalone desktop and mobile apps in Rust and Svelte",
  "workspaces": [
    "apps/*/ui",
    "apps/*",
    "shared/ui-kit"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "build:all": "cargo build --workspace --release"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
